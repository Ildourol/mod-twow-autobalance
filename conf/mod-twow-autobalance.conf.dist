AutoBalance.StatModifierRaid60M.Boss.Global = 1.0
AutoBalance.StatModifierRaid60M.Boss.Health = 1.0
AutoBalance.StatModifierRaid60M.Boss.Mana = 1.0
AutoBalance.StatModifierRaid60M.Boss.Armor = 1.0
